{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":enableVulnerabilityAlertsWithLabel(security)"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 6am every weekday"
  ],
  "minimumReleaseAge": "2 days",
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "pinDigests": true,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "rebaseWhen": "auto",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "グループ1: mise のツール一式を 1 PR にまとめる",
      "matchManagers": [
        "mise"
      ],
      "groupName": "mise tools",
      "groupSlug": "mise-tools"
    },
    {
      "description": "グループ2: GitHub Actions 一式を 1 PR にまとめる（コミット SHA 固定）",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "グループ3: Skills（APM）を 1 PR にまとめる（apm.yml の owner/repo#ref を更新）",
      "matchManagers": [
        "apm"
      ],
      "groupName": "Skills (APM)",
      "groupSlug": "skills-apm"
    },
    {
      "description": "flake.lock は Renovate ではなく専用 workflow（2日以上前の commit にだけ更新）で更新する（PLAN.md）",
      "matchManagers": [
        "nix"
      ],
      "enabled": false
    },
    {
      "description": "mise / APM の lock は relock ワークフローが再生成する。Mend hosted の Renovate は mise lock / apm install を実行できない（unsafe execution / CLI 無し）ため、artifact 更新は試行しない",
      "matchManagers": [
        "mise",
        "apm"
      ],
      "skipArtifactsUpdate": true,
      "lockFileMaintenance": {
        "enabled": false
      }
    },
    {
      "description": "minor / patch は必須チェック（lint / mise-lock / nix）が通れば自動マージ。major と pin / digest は手動",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "mise": {
    "updatePinnedDependencies": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "description": "脆弱性アラート由来の更新は、スケジュール・リリース経過日数・Dashboard 承認を迂回して即座に PR を作り、必須チェックが通れば自動マージする",
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null,
    "groupName": null,
    "automerge": true,
    "platformAutomerge": true
  },
  "osvVulnerabilityAlerts": true,
  "automergeStrategy": "squash"
}
